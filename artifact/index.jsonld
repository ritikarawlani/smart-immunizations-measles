      }
    },
    {
      "@id": "ActorDefinition-MEASLES.P.DataManager",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/MEASLES.P.DataManager",
      "dcterms:title": "Immunization data manager",
      "schema:name": "MEASLESDataManager",
      "dcterms:description": "Aggregates doses by antigen and dose number, computes coverage and fills the WHO/UNICEF Joint Reporting Form. Specialises DAK.Persona.DataManager.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/immunizations-measles/ActorDefinition/MEASLES.P.DataManager"
      },
