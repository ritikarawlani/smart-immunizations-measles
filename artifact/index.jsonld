    {
      "@id": "ActorDefinition-MEASLES.P.HealthWorker",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/MEASLES.P.HealthWorker",
      "dcterms:title": "Health worker (vaccinator)",
      "schema:name": "MEASLESHealthWorker",
      "dcterms:description": "Checks a client's vaccination record, decides which measles-containing vaccine dose is due, screens for contraindications, vaccinates, records the dose and gives the return date. Specialises DAK.Persona.HealthcareProvider.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/immunizations-measles/ActorDefinition/MEASLES.P.HealthWorker"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-MEASLES.P.HealthWorker.json"
      }
    },
    {
