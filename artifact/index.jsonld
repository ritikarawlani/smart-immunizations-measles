      "@id": "ActorDefinition-MEASLES.P.Client",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/MEASLES.P.Client",
      "dcterms:title": "Client and caregiver",
      "schema:name": "MEASLESClient",
      "dcterms:description": "The child, adolescent or adult who is vaccinated, and the caregiver who brings a child and keeps the home-based record. Specialises DAK.Persona.Person.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/immunizations-measles/ActorDefinition/MEASLES.P.Client"
      },
