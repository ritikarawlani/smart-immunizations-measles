      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/MEASLES.P.ProgrammeManager",
      "dcterms:title": "Immunization programme manager",
      "schema:name": "MEASLESProgrammeManager",
      "dcterms:description": "Sets the national schedule, the catch-up policy and health-worker immunity rules, and organises defaulter tracking. Specialises DAK.Persona.HealthSystemManager.",
