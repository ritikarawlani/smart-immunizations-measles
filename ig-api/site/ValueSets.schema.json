{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/ValueSets.schema.json",
  "title": "ValueSet Enumeration Schema",
  "description": "JSON Schema defining the structure of the ValueSet enumeration endpoint response",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "valueset",
      "description": "The type of schemas enumerated (valueset)"
    },
    "count": {
      "type": "integer",
      "description": "Total number of schemas available"
    },
    "schemas": {
      "type": "array",
      "description": "Array of available schemas",
      "items": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "description": "Schema filename"
          },
          "id": {
            "type": "string",
            "description": "Schema $id"
          },
          "title": {
            "type": "string",
            "description": "Schema title"
          },
          "description": {
            "type": "string",
            "description": "Schema description"
          },
          "url": {
            "type": "string",
            "description": "Relative URL to the schema file"
          },
          "valueSetUrl": {
            "type": "string",
            "description": "FHIR canonical URL of the ValueSet"
          },
          "codeCount": {
            "type": "integer",
            "description": "Number of codes in the ValueSet"
          }
        },
        "required": [
          "filename",
          "title",
          "url"
        ]
      }
    }
  },
  "required": [
    "type",
    "count",
    "schemas"
  ],
  "example": {
    "type": "valueset",
    "count": 9,
    "schemas": [
      {
        "filename": "ValueSet-MeaslesHealthWorkerMeaslesImmunityProofVS.schema.json",
        "id": "http://smart.who.int/immunizations-measles/ValueSet-MeaslesHealthWorkerMeaslesImmunityProofVS.schema.json",
        "title": "Health worker measles immunity proof Schema",
        "description": "JSON Schema for Health worker measles immunity proof ValueSet codes. Values are represented as Coding objects with 'system' and 'code' properties.",
        "url": "./ValueSet-MeaslesHealthWorkerMeaslesImmunityProofVS.schema.json",
        "valueSetUrl": "http://smart.who.int/immunizations-measles/ValueSet/MeaslesHealthWorkerMeaslesImmunityProofVS"
      },
      {
        "filename": "ValueSet-MeaslesHivStatusVS.schema.json",
        "id": "http://smart.who.int/immunizations-measles/ValueSet-MeaslesHivStatusVS.schema.json",
        "title": "HIV status Schema",
        "description": "JSON Schema for HIV status ValueSet codes. Values are represented as Coding objects with 'system' and 'code' properties.",
        "url": "./ValueSet-MeaslesHivStatusVS.schema.json",
        "valueSetUrl": "http://smart.who.int/immunizations-measles/ValueSet/MeaslesHivStatusVS"
      },
      {
        "filename": "ValueSet-MeaslesMcvDoseDoseLabelVS.schema.json",
        "id": "http://smart.who.int/immunizations-measles/ValueSet-MeaslesMcvDoseDoseLabelVS.schema.json",
        "title": "MCV dose: dose label Schema",
        "description": "JSON Schema for MCV dose: dose label ValueSet codes. Values are represented as Coding objects with 'system' and 'code' properties.",
        "url": "./ValueSet-MeaslesMcvDoseDoseLabelVS.schema.json",
        "valueSetUrl": "http://smart.who.int/immunizations-measles/ValueSet/MeaslesMcvDoseDoseLabelVS"
      },
      {
        "filename": "ValueSet-MeaslesMcvDoseVaccineVS.schema.json",
        "id": "http://smart.who.int/immunizations-measles/ValueSet-MeaslesMcvDoseVaccineVS.schema.json",
        "title": "MCV dose: vaccine Schema",
        "description": "JSON Schema for MCV dose: vaccine ValueSet codes. Values are represented as Coding objects with 'system' and 'code' properties.",
        "url": "./ValueSet-MeaslesMcvDoseVaccineVS.schema.json",
        "valueSetUrl": "http://smart.who.int/immunizations-measles/ValueSet/MeaslesMcvDoseVaccineVS"
      },
      {
        "filename": "ValueSet-MeaslesNationalScheduleSettingVS.schema.json",
        "id": "http://smart.who.int/immunizations-measles/ValueSet-MeaslesNationalScheduleSettingVS.schema.json",
        "title": "National schedule setting Schema",
        "description": "JSON Schema for National schedule setting ValueSet codes. Values are represented as Coding objects with 'system' and 'code' properties.",
        "url": "./ValueSet-MeaslesNationalScheduleSettingVS.schema.json",
        "valueSetUrl": "http://smart.who.int/immunizations-measles/ValueSet/MeaslesNationalScheduleSettingVS"
      },
      {
        "filename": "ValueSet-MeaslesReasonNotVaccinatedVS.schema.json",
        "id": "http://smart.who.int/immunizations-measles/ValueSet-MeaslesReasonNotVaccinatedVS.schema.json",
        "title": "Reason not vaccinated Schema",
        "description": "JSON Schema for Reason not vaccinated ValueSet codes. Values are represented as Coding objects with 'system' and 'code' properties.",
        "url": "./ValueSet-MeaslesReasonNotVaccinatedVS.schema.json",
        "valueSetUrl": "http://smart.who.int/immunizations-measles/ValueSet/MeaslesReasonNotVaccinatedVS"
      },
      {
        "filename": "ValueSet-MeaslesScreeningOutcomeVS.schema.json",
        "id": "http://smart.who.int/immunizations-measles/ValueSet-MeaslesScreeningOutcomeVS.schema.json",
        "title": "Screening outcome Schema",
        "description": "JSON Schema for Screening outcome ValueSet codes. Values are represented as Coding objects with 'system' and 'code' properties.",
        "url": "./ValueSet-MeaslesScreeningOutcomeVS.schema.json",
        "valueSetUrl": "http://smart.who.int/immunizations-measles/ValueSet/MeaslesScreeningOutcomeVS"
      },
      {
        "filename": "ValueSet-MeaslesSexVS.schema.json",
        "id": "http://smart.who.int/immunizations-measles/ValueSet-MeaslesSexVS.schema.json",
        "title": "Sex Schema",
        "description": "JSON Schema for Sex ValueSet codes. Values are represented as Coding objects with 'system' and 'code' properties.",
        "url": "./ValueSet-MeaslesSexVS.schema.json",
        "valueSetUrl": "http://smart.who.int/immunizations-measles/ValueSet/MeaslesSexVS"
      },
      {
        "filename": "ValueSet-MeaslesSupplementaryDoseIndicationVS.schema.json",
        "id": "http://smart.who.int/immunizations-measles/ValueSet-MeaslesSupplementaryDoseIndicationVS.schema.json",
        "title": "Supplementary-dose indication Schema",
        "description": "JSON Schema for Supplementary-dose indication ValueSet codes. Values are represented as Coding objects with 'system' and 'code' properties.",
        "url": "./ValueSet-MeaslesSupplementaryDoseIndicationVS.schema.json",
        "valueSetUrl": "http://smart.who.int/immunizations-measles/ValueSet/MeaslesSupplementaryDoseIndicationVS"
      }
    ]
  }
}