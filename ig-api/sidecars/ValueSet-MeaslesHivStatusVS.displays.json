{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smart.who.int/immunizations-measles/ValueSet-MeaslesHivStatusVS.displays.json",
  "title": "HIV status Display Values",
  "description": "Display values for HIV status ValueSet codes. Generated from FHIR expansions. Keys are code fragments (the part after '#' in the canonical IRI). The full IRI can be reconstructed as system + '#' + code.",
  "type": "object",
  "properties": {
    "fhir:displays": {
      "type": "object",
      "description": "Multilingual display values for ValueSet codes keyed by code fragment",
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "description": "Display values for a specific code fragment by language",
          "properties": {
            "en": {
              "type": "string",
              "description": "English display value"
            }
          },
          "patternProperties": {
            "^[a-z]{2}(-[A-Z]{2})?$": {
              "type": "string",
              "description": "Display value in the specified language (ISO 639-1 code)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "fhir:displays"
  ],
  "additionalProperties": true,
  "fhir:displays": {
    "MEASLES.DE.17.infected": {
      "en": "infected"
    },
    "MEASLES.DE.17.exposed-infant": {
      "en": "exposed-infant"
    },
    "MEASLES.DE.17.negative": {
      "en": "negative"
    },
    "MEASLES.DE.17.unknown": {
      "en": "unknown"
    }
  },
  "fhir:valueSet": "http://smart.who.int/immunizations-measles/ValueSet/MeaslesHivStatusVS",
  "fhir:version": "0.1.0",
  "fhir:expansionTimestamp": "2026-11-23T10:32:23+00:00"
}