{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smart.who.int/immunizations-measles/ValueSet-MeaslesSupplementaryDoseIndicationVS.displays.json",
  "title": "Supplementary-dose indication Display Values",
  "description": "Display values for Supplementary-dose indication ValueSet codes. Generated from FHIR expansions. Keys are code fragments (the part after '#' in the canonical IRI). The full IRI can be reconstructed as system + '#' + code.",
  "type": "object",
  "properties": {
    "fhir:displays": {
      "type": "object",
      "description": "Multilingual display values for ValueSet codes keyed by code fragment",
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "description": "Display values for a specific code fragment by language",
          "properties": {
            "en": {
              "type": "string",
              "description": "English display value"
            }
          },
          "patternProperties": {
            "^[a-z]{2}(-[A-Z]{2})?$": {
              "type": "string",
              "description": "Display value in the specified language (ISO 639-1 code)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "fhir:displays"
  ],
  "additionalProperties": true,
  "fhir:displays": {
    "MEASLES.DE.07.outbreak-intensified-service": {
      "en": "outbreak-intensified-service"
    },
    "MEASLES.DE.07.high-risk-campaign": {
      "en": "high-risk-campaign"
    },
    "MEASLES.DE.07.displaced-refugee-conflict": {
      "en": "displaced-refugee-conflict"
    },
    "MEASLES.DE.07.contact-or-high-exposure": {
      "en": "contact-or-high-exposure"
    },
    "MEASLES.DE.07.travel-to-outbreak-country": {
      "en": "travel-to-outbreak-country"
    },
    "MEASLES.DE.07.hiv-infected-or-exposed": {
      "en": "hiv-infected-or-exposed"
    },
    "MEASLES.DE.07.high-hiv-and-measles-incidence": {
      "en": "high-hiv-and-measles-incidence"
    }
  },
  "fhir:valueSet": "http://smart.who.int/immunizations-measles/ValueSet/MeaslesSupplementaryDoseIndicationVS",
  "fhir:version": "0.1.0",
  "fhir:expansionTimestamp": "2026-11-23T10:32:24+00:00"
}