<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_MEASLES.B" targetNamespace="http://smart.who.int/immunizations-measles/bpmn">
  <bpmn:collaboration id="Collab_MEASLES.B"><bpmn:participant id="Pool_MEASLES.B" name="MEASLES.B Defaulter tracking and coverage reporting" processRef="MEASLES.B"/></bpmn:collaboration>
  <bpmn:process id="MEASLES.B" name="MEASLES.B Defaulter tracking and coverage reporting" isExecutable="false">
    <bpmn:documentation>Monthly at a facility: find children whose MCV1 or MCV2 is overdue and zero-dose children, remind and reach them (they then enter MEASLES.A), and aggregate MCV doses for the measles indicators and the WHO/UNICEF Joint Reporting Form. Derived from catchup.defaulter-tracking, catchup.mcv2-only-after-mcv1 and the JRF 2016 (rows 4160, 4180, 4260, 4270, 6250, 6270). Adjudication: pending.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_PM" name="Immunization programme manager">
        <bpmn:flowNodeRef>Start_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_B</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DM" name="Immunization data manager">
        <bpmn:flowNodeRef>B4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HWB" name="Health worker">
        <bpmn:flowNodeRef>B2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_B" name="Start of month">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="B1" name="List overdue and zero-dose children">
      <bpmn:documentation>catchup.defaulter-tracking</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="B2" name="Remind caregivers; outreach">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="B3" name="Vaccination contact (MEASLES.A)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="B4" name="Aggregate MCV doses">
      <bpmn:documentation>MCV1 and MCV2 separately; doses given late counted (JRF rows 4260/4270); never MCV2 without MCV1 (catchup.mcv2-only-after-mcv1).</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B5" name="Compute measles indicators">
      <bpmn:documentation>MEASLES.IND.01 to IND.07.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="B6" name="Review coverage and dropout">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="B7" name="Report on the JRF (annual)">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_B" name="Month closed">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_B" targetRef="B1"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="B1" targetRef="B2"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="B2" targetRef="B3"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="B3" targetRef="B4"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="B4" targetRef="B5"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="B5" targetRef="B6"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="B6" targetRef="B7"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="B7" targetRef="End_B"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_MEASLES.B"><bpmndi:BPMNPlane id="Plane_MEASLES.B" bpmnElement="Collab_MEASLES.B">
    <bpmndi:BPMNShape id="Pool_MEASLES.B_di" bpmnElement="Pool_MEASLES.B" isHorizontal="true"><dc:Bounds x="120" y="80" width="1350" height="510"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_PM_di" bpmnElement="Lane_PM" isHorizontal="true"><dc:Bounds x="150" y="80" width="1320" height="170"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_DM_di" bpmnElement="Lane_DM" isHorizontal="true"><dc:Bounds x="150" y="250" width="1320" height="170"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_HWB_di" bpmnElement="Lane_HWB" isHorizontal="true"><dc:Bounds x="150" y="420" width="1320" height="170"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Start_B_di" bpmnElement="Start_B"><dc:Bounds x="222" y="147" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="B1_di" bpmnElement="B1"><dc:Bounds x="320" y="105" width="120" height="120"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="B2_di" bpmnElement="B2"><dc:Bounds x="460" y="445" width="120" height="120"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="B3_di" bpmnElement="B3"><dc:Bounds x="600" y="445" width="120" height="120"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="B4_di" bpmnElement="B4"><dc:Bounds x="740" y="275" width="120" height="120"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="B5_di" bpmnElement="B5"><dc:Bounds x="880" y="275" width="120" height="120"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="B6_di" bpmnElement="B6"><dc:Bounds x="1020" y="105" width="120" height="120"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="B7_di" bpmnElement="B7"><dc:Bounds x="1160" y="275" width="120" height="120"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_B_di" bpmnElement="End_B"><dc:Bounds x="1342" y="147" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="258" y="165"/><di:waypoint x="320" y="165"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="440" y="165"/><di:waypoint x="520" y="165"/><di:waypoint x="520" y="445"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="580" y="505"/><di:waypoint x="600" y="505"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="720" y="505"/><di:waypoint x="800" y="505"/><di:waypoint x="800" y="395"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="860" y="335"/><di:waypoint x="880" y="335"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1000" y="335"/><di:waypoint x="1080" y="335"/><di:waypoint x="1080" y="225"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1140" y="165"/><di:waypoint x="1220" y="165"/><di:waypoint x="1220" y="275"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1280" y="335"/><di:waypoint x="1360" y="335"/><di:waypoint x="1360" y="183"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
