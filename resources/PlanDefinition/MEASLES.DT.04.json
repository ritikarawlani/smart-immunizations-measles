      },
      {
        "url" : "statement",
        "valueString" : "/* Rule 4: Table 1, page 3 (measles footnote) — T1:measles.hiv-haart-additional-dose */\ndefine \"Rule 4\":\n  Coalesce(cd4Monitored is true\n    and cd4Percent >= 20.0, false)"
