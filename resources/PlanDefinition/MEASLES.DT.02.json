  "text" : {
    "status" : "extensions",
    "div" : "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n<div>\n    <table class=\"grid dict\">\n        \n        <tr>\n            <th scope=\"row\"><b>Id: </b></th>\n            <td style=\"padding-left: 4px;\">MEASLES.DT.02</td>\n        </tr>\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Url: </b></th>\n            <td style=\"padding-left: 4px;\"><a href=\"PlanDefinition-MEASLES.DT.02.html\">MEASLES.DT.02 Screen before measles vaccination</a></td>\n        </tr>\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Version: </b></th>\n            <td style=\"padding-left: 4px;\">0.1.0</td>\n        </tr>\n        \n\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Title: </b></th>\n            <td style=\"padding-left: 4px;\">MEASLES.DT.02 Screen before measles vaccination</td>\n        </tr>\n        \n\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Status: </b></th>\n            <td style=\"padding-left: 4px;\">draft</td>\n        </tr>\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Experimental: </b></th>\n            <td style=\"padding-left: 4px;\">true</td>\n        </tr>\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Type: </b></th>\n            <td style=\"padding-left: 4px;\">\n                \n                    \n                        \n                        <p style=\"margin-bottom: 5px;\">\n                            <b>system: </b> <span><a href=\"http://terminology.hl7.org/7.5.0/CodeSystem-plan-definition-type.html\">http://terminology.hl7.org/CodeSystem/plan-definition-type</a></span>\n                        </p>\n                        \n                        \n                        <p style=\"margin-bottom: 5px;\">\n                            <b>code: </b> <span>eca-rule</span>\n                        </p>\n                        \n                        \n                    \n                \n                \n            </td>\n        </tr>\n        \n\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Date: </b></th>\n            <td style=\"padding-left: 4px;\">2026-11-23 11:02:25+0000</td>\n        </tr>\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Publisher: </b></th>\n            <td style=\"padding-left: 4px;\">WHO</td>\n        </tr>\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Description: </b></th>\n            <td style=\"padding-left: 4px;\"><div><p>Whether to vaccinate today, defer, or not vaccinate. Hit policy FIRST. A mild concurrent infection is not a reason to defer. Adjudication: pending. L3 of input/decision-logic/MEASLES.DT.02.dmn.</p>\n</div></td>\n        </tr>\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Libraries: </b></th>\n            <td style=\"padding-left: 4px;\">\n                <table class=\"grid-dict\">\n                    \n                    <tr>\n                        <td><a href=\"Library-MEASLESDT02.html\">MEASLES.DT.02 Screen before measles vaccination (logic)</a></td>\n                    </tr>\n                    \n                </table>\n            </td>\n        </tr>\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Actions: </b></th>\n            <td style=\"padding-left: 4px;\">\n                <table class=\"grid-dict\">\n                    \n                    <tr>\n                        <td>\n                            \n                            <b> Rule 1: do-not-vaccinate:</b> History of anaphylaxis or severe allergy to a component (e.g. neomycin, gelatin).\n                            \n                            <br/>\n                            \n                            \n                            <b>If:</b>\n                            \n                            <i>Applicability:</i>\n                            \n                            <i>(Rule 1 fires)</i>\n                            <br/>\n                            \n                            \n                            \n                            \n                            \n                        </td>\n                    </tr>\n                    \n                    <tr>\n                        <td>\n                            \n                            <b> Rule 2: do-not-vaccinate:</b> Severe immunosuppression.\n                            \n                            <br/>\n                            \n                            \n                            <b>If:</b>\n                            \n                            <i>Applicability:</i>\n                            \n                            <i>(Rule 2 fires)</i>\n                            <br/>\n                            \n                            \n                            \n                            \n                            \n                        </td>\n                    </tr>\n                    \n                    <tr>\n                        <td>\n                            \n                            <b> Rule 3: defer:</b> Pregnant: vaccinate after the pregnancy.\n                            \n                            <br/>\n                            \n                            \n                            <b>If:</b>\n                            \n                            <i>Applicability:</i>\n                            \n                            <i>(Rule 3 fires)</i>\n                            <br/>\n                            \n                            \n                            \n                            \n                            \n                        </td>\n                    </tr>\n                    \n                    <tr>\n                        <td>\n                            \n                            <b> Rule 4: defer:</b> Another live vaccine less than 4 weeks ago: give on the same day or wait until 4 weeks have passed.\n                            \n                            <br/>\n                            \n                            \n                            <b>If:</b>\n                            \n                            <i>Applicability:</i>\n                            \n                            <i>(Rule 4 fires)</i>\n                            <br/>\n                            \n                            \n                            \n                            \n                            \n                        </td>\n                    </tr>\n                    \n                    <tr>\n                        <td>\n                            \n                            <b> Rule 5: proceed:</b> No contraindication; a mild concurrent infection does not count.\n                            \n                            <br/>\n                            \n                            \n                            <b>If:</b>\n                            \n                            <i>Applicability:</i>\n                            \n                            <i>(Rule 5 fires)</i>\n                            <br/>\n                            \n                            \n                            \n                            \n                            \n                        </td>\n                    </tr>\n                    \n                    <tr>\n                        <td>\n                            \n                            <b> Rule 6: unknown:</b> Not settled: ask about allergy, immunosuppression and pregnancy.\n                            \n                            <br/>\n                            \n                            \n                            <b>If:</b>\n                            \n                            <i>Applicability:</i>\n                            \n                            <i>(Rule 6 fires)</i>\n                            <br/>\n                            \n                            \n                            \n                            \n                            \n                        </td>\n                    </tr>\n                    \n                </table>\n            </td>\n        </tr>\n        \n    </table>\n</div>\n</div>"
  },
  "contained" : [{
    "resourceType" : "Library",
    "id" : "effective-data-requirements",
    "extension" : [{
      "extension" : [{
        "url" : "libraryName",
        "valueString" : "MEASLESDT02"
      },
      {
        "url" : "name",
        "valueString" : "Rule 1"
      },
      {
        "url" : "statement",
        "valueString" : "/* Rule 1: Table 1, page 3 (measles footnote) — T1:measles.contraindications */\ndefine \"Rule 1\":\n  Coalesce(anaphylaxisToComponent is true, false)"
      },
      {
        "url" : "displaySequence",
        "valueInteger" : 0
      }],
      "url" : "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
    },
    {
      "extension" : [{
        "url" : "libraryName",
        "valueString" : "MEASLESDT02"
      },
      {
        "url" : "name",
        "valueString" : "Rule 1 fires"
      },
      {
        "url" : "statement",
        "valueString" : "define \"Rule 1 fires\":\n  \"Rule 1\""
      },
      {
        "url" : "displaySequence",
        "valueInteger" : 1
      }],
      "url" : "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
    },
    {
      "extension" : [{
        "url" : "libraryName",
        "valueString" : "MEASLESDT02"
      },
      {
        "url" : "name",
        "valueString" : "Rule 2"
      },
      {
        "url" : "statement",
        "valueString" : "/* Rule 2: Table 1, page 3 (measles footnote) — T1:measles.contraindications. Asymptomatic HIV infection is not this: those clients are vaccinated (measles.hiv-routine-vaccination). */\ndefine \"Rule 2\":\n  Coalesce(severeImmunosuppression is true, false)"
      },
      {
        "url" : "displaySequence",
        "valueInteger" : 2
      }],
      "url" : "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
    },
    {
      "extension" : [{
        "url" : "libraryName",
        "valueString" : "MEASLESDT02"
      },
      {
        "url" : "name",
        "valueString" : "Rule 2 fires"
      },
      {
        "url" : "statement",
        "valueString" : "define \"Rule 2 fires\":\n  \"Rule 2\" and not (\"Rule 1\")"
      },
      {
        "url" : "displaySequence",
        "valueInteger" : 3
      }],
      "url" : "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
    },
    {
      "extension" : [{
        "url" : "libraryName",
        "valueString" : "MEASLESDT02"
      },
      {
        "url" : "name",
        "valueString" : "Rule 4"
      },
      {
        "url" : "statement",
        "valueString" : "/* Rule 4: Table 1, page 3 (measles footnote); catch-up guide, page 14 — T1:measles.live-vaccine-spacing CU:catchup.live-vaccine-spacing. OPV is the printed exception and does not count here. */\ndefine \"Rule 4\":\n  Coalesce(weeksSinceOtherLiveVaccine < 4.0, false)"
      },
      {
        "url" : "displaySequence",
        "valueInteger" : 4
      }],
      "url" : "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
    },
    {
      "extension" : [{
        "url" : "libraryName",
        "valueString" : "MEASLESDT02"
      },
      {
        "url" : "name",
        "valueString" : "Rule 3"
      },
      {
        "url" : "statement",
        "valueString" : "/* Rule 3: Table 1, page 3 (measles footnote) — T1:measles.avoid-in-pregnancy. A precaution. */\ndefine \"Rule 3\":\n  Coalesce(pregnant is true, false)"
      },
      {
        "url" : "displaySequence",
        "valueInteger" : 5
      }],
      "url" : "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
    },
    {
      "extension" : [{
        "url" : "libraryName",
        "valueString" : "MEASLESDT02"
      },
      {
        "url" : "name",
        "valueString" : "Rule 4 fires"
      },
      {
        "url" : "statement",
        "valueString" : "define \"Rule 4 fires\":\n  \"Rule 4\" and not (\"Rule 1\" or \"Rule 2\" or \"Rule 3\")"
      },
      {
        "url" : "displaySequence",
        "valueInteger" : 6
      }],
      "url" : "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
    },
    {
      "extension" : [{
        "url" : "libraryName",
        "valueString" : "MEASLESDT02"
      },
      {
        "url" : "name",
        "valueString" : "Rule 6"
      },
      {
        "url" : "statement",
        "valueString" : "/* Rule 6: No source: returned only when the inputs match no rule above (a fact is missing or out of range). */\ndefine \"Rule 6\":\n  Coalesce(true, false)"
      },
      {
        "url" : "displaySequence",
        "valueInteger" : 7
      }],
      "url" : "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
    },
    {
      "extension" : [{
        "url" : "libraryName",
        "valueString" : "MEASLESDT02"
      },
      {
        "url" : "name",
        "valueString" : "Rule 5"
      },
      {
        "url" : "statement",
        "valueString" : "/* Rule 5: Table 1, page 3 (measles footnote) — T1:measles.mild-infection-not-contraindication */\ndefine \"Rule 5\":\n  Coalesce(anaphylaxisToComponent is false\n    and severeImmunosuppression is false\n    and pregnant is false, false)"
      },
      {
        "url" : "displaySequence",
        "valueInteger" : 8
      }],
      "url" : "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
    },
    {
      "extension" : [{
        "url" : "libraryName",
        "valueString" : "MEASLESDT02"
      },
      {
        "url" : "name",
        "valueString" : "Rule 6 fires"
      },
      {
        "url" : "statement",
        "valueString" : "define \"Rule 6 fires\":\n  \"Rule 6\" and not (\"Rule 1\" or \"Rule 2\" or \"Rule 3\" or \"Rule 4\" or \"Rule 5\")"
      },
      {
        "url" : "displaySequence",
        "valueInteger" : 9
      }],
      "url" : "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
    },
    {
      "extension" : [{
        "url" : "libraryName",
        "valueString" : "MEASLESDT02"
