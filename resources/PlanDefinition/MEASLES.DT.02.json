      {
        "url" : "name",
        "valueString" : "Rule 3 fires"
      },
      {
        "url" : "statement",
        "valueString" : "define \"Rule 3 fires\":\n  \"Rule 3\" and not (\"Rule 1\" or \"Rule 2\")"
      },
      {
        "url" : "displaySequence",
        "valueInteger" : 10
      }],
