bed-snapshots"},{"url":"value","valueString":"true"}],"url":"http://hl7.org/fhir/tools/StructureDefinition/ig-parameter"}],"resource":[{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActorDefinition"}],"reference":{"reference":"ActorDefinition/MEASLES.P.Client"},"name":"Client and caregiver","description":"The child, adolescent or adult who is vaccinated, and the caregiver who brings a child and keeps the home-based record. Specialises DAK.Persona.Person.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Measure"}],"reference":{"reference":"Measure/MEASLES.IND.07"},"name":"Confirmed measles cases","description":"Number of patients with a confirmed measles case recorded in the period (JRF 2016 row 1020).","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActorDefinition"}],"reference":{"reference":"ActorDefinition/MEASLES.P.HealthWorker"},"name":"Health worker (vaccinator)","description":"Checks a client's vaccination record, decides which measles-containing vaccine dose is due, screens for contraindications, vaccinates, records the dose and gives the return date. Specialises DAK.Persona.HealthcareProvider.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/MeaslesHealthWorkerMeaslesImmunityProofVS"},"name":"Health worker measles immunity proof","description":"Allowed values of MEASLES.DE.25 (Health worker measles immunity proof).","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/MeaslesHivStatusVS"},"name":"HIV status","description":"Allowed values of MEASLES.DE.17 (HIV status).","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActorDefinition"}],"reference":{"reference":"ActorDefinition/MEASLES.P.DataManager"},"name":"Immunization data manager","description":"Aggregates doses by antigen and dose number, computes coverage and fills the WHO/UNICEF Joint Reporting Form. Specialises DAK.Persona.DataManager.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ActorDefinition"}],"reference":{"reference":"ActorDefinition/MEASLES.P.ProgrammeManager"},"name":"Immunization programme manager","description":"Sets the national schedule, the catch-up policy and health-worker immunity rules, and organises defaulter tracking. Specialises DAK.Persona.HealthSystemManager.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/MeaslesMcvDoseDoseLabelVS"},"name":"MCV dose: dose label","description":"Allowed values of MEASLES.DE.09 (MCV dose: dose label).","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/MeaslesMcvDoseVaccineVS"},"name":"MCV dose: vaccine","description":"Allowed values of MEASLES.DE.10 (MCV dose: vaccine).","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Measure"}],"reference":{"reference":"Measure/MEASLES.IND.01"},"name":"MCV1 coverage","description":"Percentage of surviving infants who received MCV1 (JRF 2016 row 4160). Denominator interpreted as registered children who turned 1 in the period.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Measure"}],"reference":{"reference":"Measure/MEASLES.IND.06"},"name":"MCV1-MCV2 dropout","description":"Percentage of children with MCV1 who have no MCV2, among children who turned 2 in the period.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Measure"}],"reference":{"reference":"Measure/MEASLES.IND.02"},"name":"MCV2 coverage","description":"Percentage of the MCV2 target population who received MCV2 (JRF 2016 row 4180). Denominator interpreted as registered children who turned 2 in the period.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"CodeSystem"}],"reference":{"reference":"CodeSystem/MeaslesConcepts"},"name":"Measles concepts","description":"Concepts of the measles DAK: its core data elements (MEASLES.DE.*) and their allowed values. Local codes; binding to SNOMED CT, LOINC or ICD-11 awaits the terminologist's review.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Requirements"}],"reference":{"reference":"Requirements/MEASLES.FR"},"name":"Measles functional requirements","description":"What a digital system supporting MEASLES.A and MEASLES.B must do; L3 of the L2 requirements.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Library"}],"reference":{"reference":"Library/MEASLESIndicators"},"name":"Measles indicators (logic)","description":"CQL for the measles indicator Measures; L3 of input/indicators/measles-indicators.csv.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"StructureDefinition:logical"}],"reference":{"reference":"StructureDefinition/MeaslesVaccinationContact"},"name":"Measles vaccination contact","description":"The data a measles vaccination contact (MEASLES.A) and its reporting (MEASLES.B) record: the core data elements MEASLES.DE.01-26.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"PlanDefinition"}],"reference":{"reference":"PlanDefinition/MEASLES.DT.01"},"name":"MEASLES.DT.01 Determine measles-containing vaccine dose due","description":"Which MCV dose, if any, a client needs today, from the doses DT.03 counted as valid. Hit policy FIRST. Derived from Table 1's measles footnote and Table 3's measles row (input/L2/provenance.json). Adjudication: pending. L3 of input/decision-logic/MEASLES.DT.01.dmn.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Library"}],"reference":{"reference":"Library/MEASLESDT01"},"name":"MEASLES.DT.01 Determine measles-containing vaccine dose due (logic)","description":"CQL of MEASLES.DT.01, rule for rule; derived from input/decision-logic/MEASLES.DT.01.dmn.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"PlanDefinition"}],"reference":{"reference":"PlanDefinition/MEASLES.DT.02"},"name":"MEASLES.DT.02 Screen before measles vaccination","description":"Whether to vaccinate today, defer, or not vaccinate. Hit policy FIRST. A mild concurrent infection is not a reason to defer. Adjudication: pending. L3 of input/decision-logic/MEASLES.DT.02.dmn.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Library"}],"reference":{"reference":"Library/MEASLESDT02"},"name":"MEASLES.DT.02 Screen before measles vaccination (logic)","description":"CQL of MEASLES.DT.02, rule for rule; derived from input/decision-logic/MEASLES.DT.02.dmn.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"PlanDefinition"}],"reference":{"reference":"PlanDefinition/MEASLES.DT.03"},"name":"MEASLES.DT.03 Count a recorded measles-containing vaccine dose","description":"How one recorded MCV dose counts, evaluated dose by dose in date order. Hit policy FIRST. Adjudication: pending. L3 of input/decision-logic/MEASLES.DT.03.dmn.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Library"}],"reference":{"reference":"Library/MEASLESDT03"},"name":"MEASLES.DT.03 Count a recorded measles-containing vaccine dose (logic)","description":"CQL of MEASLES.DT.03, rule for rule; derived from input/decision-logic/MEASLES.DT.03.dmn.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"PlanDefinition"}],"reference":{"reference":"PlanDefinition/MEASLES.DT.04"},"name":"MEASLES.DT.04 Additional measles dose for a child living with HIV on HAART","description":"Whether an HIV-infected child receiving HAART needs the additional MCV dose after immune reconstitution. Hit policy FIRST. Adjudication: pending. L3 of input/decision-logic/MEASLES.DT.04.dmn.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"Library"}],"reference":{"reference":"Library/MEASLESDT04"},"name":"MEASLES.DT.04 Additional measles dose for a child living with HIV on HAART (logic)","description":"CQL of MEASLES.DT.04, rule for rule; derived from input/decision-logic/MEASLES.DT.04.dmn.","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/MeaslesNationalScheduleSettingVS"},"name":"National schedule setting","description":"Allowed values of MEASLES.DE.06 (National schedule setting).","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/MeaslesReasonNotVaccinatedVS"},"name":"Reason not vaccinated","description":"Allowed values of MEASLES.DE.23 (Reason not vaccinated).","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/MeaslesScreeningOutcomeVS"},"name":"Screening outcome","description":"Allowed values of MEASLES.DE.22 (Screening outcome).","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/MeaslesSexVS"},"name":"Sex","description":"Allowed values of MEASLES.DE.03 (Sex).","exampleBoolean":false},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/resource-information","valueString":"ValueSet"}],"reference":{"reference":"ValueSet/MeaslesSupplementaryDoseIndicationVS"},"name":"Supplementary-dose indication","description":"Allowed values of MEASLES.DE.07 (Supplementary-dose indication).","exampleBoolean":false}],"page":{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/ig-page-name","valueUrl":"toc.html"}],"nameUrl":"toc.html","title":"Table of Contents","generation":"html","page":[{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/ig-page-name","valueUrl":"index.html"}],"nameUrl":"index.html","title":"Home","generation":"markdown"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/ig-page-name","valueUrl":"l2-dependencies.html"}],"nameUrl":"l2-dependencies.html","title":"L2 dependencies","generation":"markdown"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/ig-page-name","valueUrl":"personas.html"}],"nameUrl":"personas.html","title":"Personas","generation":"markdown"},{"extension":[{"url":"http://hl7.org/fhir/tools/StructureDefinition/ig-page-name","valueUrl":"user-scenarios.html"}],"nameUrl":"user-scenarios.html","title":"User scenarios","generation":"markdown"},{"extensio